# ============================================================
# SOS Super MKT — WhatsApp Bot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

NODE_ENV=production
PORT=3000

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:SENHA_SEGURA@localhost:5432/supercrmzap

# Cache Redis
REDIS_URL=redis://localhost:6379

# JWT — gere com: openssl rand -hex 64
JWT_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_LONGA
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_CHAVE_ALEATORIA_LONGA

# ── URLS DE PRODUÇÃO ──────────────────────────────────────
API_URL=https://supercrmapi.openwave.online
FRONTEND_URL=https://supercrmapp.openwave.online

# ── EVOLUTION GO (WhatsApp API) ───────────────────────────
# URL da instância Evolution Go (ex: http://localhost:8080 ou URL externa)
EVOLUTION_API_URL=http://localhost:8080
# Chave global definida na configuração do Evolution Go
EVOLUTION_API_KEY=TROQUE_PELA_CHAVE_DO_EVOLUTION_GO

# ── N8N (Automações) ──────────────────────────────────────
# Deixe em branco para desativar repasse de eventos ao n8n
N8N_WEBHOOK_URL=

# ── ASAAS (Pagamentos PIX/Recorrência) ───────────────────
ASAAS_API_KEY=
# true = sandbox (testes) | false = produção real
ASAAS_SANDBOX=true

# ── E-MAIL (Nodemailer SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_gmail
SMTP_FROM=SOS Super MKT <no-reply@openwave.online>

# ── MINIO (Armazenamento de mídias) ───────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=TROQUE_SENHA_MINIO
MINIO_USE_SSL=false
MINIO_BUCKET=supercrmzap
