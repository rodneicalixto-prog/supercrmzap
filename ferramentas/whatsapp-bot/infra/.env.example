# ============================================
# SOS Super MKT — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ============================================

# Geral
NODE_ENV=production

# Banco de dados
DB_PASSWORD=troque_por_senha_segura

# JWT Auth
JWT_SECRET=troque_por_chave_aleatoria_longa_minimo_32_chars
JWT_REFRESH_SECRET=troque_por_outra_chave_aleatoria_longa

# Evolution Go (WhatsApp API)
EVOLUTION_API_KEY=troque_por_chave_api_evolution

# n8n
N8N_USER=admin
N8N_PASSWORD=troque_por_senha_n8n
N8N_HOST=localhost

# MinIO (armazenamento de mídias)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=troque_por_senha_minio

# Asaas (pagamentos)
ASAAS_API_KEY=$aas_sua_chave_aqui
ASAAS_SANDBOX=true

# SMTP (recuperação de senha e e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com.br
SMTP_PASS=sua_senha_de_app_gmail
SMTP_FROM=SOS Super MKT <no-reply@seudominio.com.br>

# URLs do frontend
VITE_API_URL=https://api.seudominio.com.br
VITE_WS_URL=wss://api.seudominio.com.br
